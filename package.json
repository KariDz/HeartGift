{
  "name": "heartgift",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A personal 19.11 gift using the browser-delivered DLove viewer, locally hosted assets and editable configuration.",
  "scripts": {
    "dev": "python3 -m http.server 8000 --bind 127.0.0.1 --directory site",
    "check": "python3 scripts/validate_site.py && node --check tests/dlove-smoke.mjs",
    "build": "python3 scripts/build_site.py",
    "preview": "python3 -m http.server 8001 --bind 127.0.0.1 --directory dist",
    "test": "node tests/dlove-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
